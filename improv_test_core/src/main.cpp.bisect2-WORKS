// BISECT шаг 2 (РАБОТАЕТ): Improv через глобальный instance + s_link.begin().
// s_link.loop() НЕ вызывается. NVS save через Link callback тут НЕ работает,
// но Improv-handshake чистый и WiFi подключается.
//
// Это последнее подтверждённое рабочее состояние.

#include <Arduino.h>
#include <WiFi.h>
#include <ImprovWiFiLibrary.h>
#include <iDryer.h>

ImprovWiFi improv(&Serial);
bool wifiOk = false;

static const iDryer::Config CFG = {
    .deviceType        = iDryer::DeviceType::StorageLink,
    .unitsCount        = 1,
    .hasHeaterPower    = false,
    .hasFanStatus      = false,
    .hasLed            = false,
    .hasScales         = false,
    .hasRfid           = false,
    .hasAirTemp        = false,
    .hasAirHumidity    = false,
    .hasHeaterTemp     = false,
    .allowHa           = false,
    .allowBambu        = false,
    .allowMoonraker    = false,
    .telemetryPeriodMs = 0,
    .statusPeriodMs    = 0,
    .hardwareVersion   = "1.0",
    .firmwareVersion   = "1.0.0",
    .model             = "iDryer Bisect 2",
};
static iDryer::Link s_link(CFG);

void onConnected(const char* ssid, const char* /*pass*/) {
    wifiOk = true;
    Serial.println();
    Serial.print("[IMPROV] connected: ");
    Serial.println(ssid);
    Serial.print("[IMPROV] IP: ");
    Serial.println(WiFi.localIP());
    Serial.flush();
}

void onError(ImprovTypes::Error err) {
    Serial.println();
    Serial.print("[IMPROV] ERROR=");
    Serial.println((int)err);
    Serial.flush();
}

void setup() {
    Serial.begin(115200);

    improv.setDeviceInfo(
        ImprovTypes::ChipFamily::CF_ESP32_C3,
        "iDryer Bisect 2",
        "1.0.0",
        "iDryer",
        "");
    improv.onImprovConnected(onConnected);
    improv.onImprovError(onError);

    s_link.begin();
}

void loop() {
    if (!wifiOk) {
        improv.handleSerial();
    }
    // s_link.loop() — НЕ вызываем (это часть BISECT 3, который не работает).
}
